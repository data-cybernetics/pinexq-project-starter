from procon.step import Step, version
import logging

logger = logging.getLogger(__name__)

class FirstStep(Step):
    """
    First example for a compute module
    """

    @version("0.0.1")  # increase version for each deployment
    def hello_world(self) -> str:
        """
        A hello world example.

        Some python code documentation:
        ```python
        print("Hello World!")
        ```
        """
        message = "Hello World!"
        logger.info(message)
        return message


if __name__ == "__main__":
    FirstStep()
